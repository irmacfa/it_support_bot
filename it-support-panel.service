[Unit]
Description=IT Support Bot - Admin Panel (Uvicorn)
After=network.target

[Service]
Type=simple
User=ali
WorkingDirectory=/home/ali/it_support_bot
ExecStart=/home/ali/it_support_bot/venv/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
